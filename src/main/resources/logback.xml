<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %boldCyan(%-34.-34thread) %red(%10.10X{jda.shard}) %boldGreen(%-15.-15logger{0}) %highlight(%-6level) %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="DISCORD" class="com.github.napstr.logback.DiscordAppender">
        <webhookUri/>
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>`%d{HH:mm:ss.SSS} [%thread] [%logger{0}] [%level] %msg`%n%replace(```%ex{full}```){'``````',''}%nopex</pattern>
        </layout>
        <username>Scissors</username>
        <avatarUrl>https://cdn.discordapp.com/avatars/1428113002460090493/fde157c606bcd4ddf8c1a5902792ec48.webp</avatarUrl>
        <tts>false</tts>
    </appender>
    <appender name="ASYNC_DISCORD" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DISCORD"/>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC_DISCORD"/>
    </root>
</configuration>